<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title> NED College - Enrolment letter </title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body { font-family: system-ui, sans-serif; background: #1a3a5c;
           display: flex; flex-direction: column; }
    iframe { flex: 1; width: 100%; border: 0; }
    .barra { background: #1a3a5c; text-align: center; padding: 10px; }
    .btn { display: inline-block; background: #2e6da4; color: #fff;
           text-decoration: none; padding: 10px 20px; border-radius: 8px;
           font-weight: bold; font-size: 14px; }
  </style>
</head>
<body>
  <iframe src="carta.pdf" title="Comprovante de aulas"></iframe>
  <div class="barra">
    <a class="btn" href="carta.pdf" >Baixar comprovante (PDF)</a>
  </div>
</body>
</html>
